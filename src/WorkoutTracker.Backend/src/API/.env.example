
# --- Required: PostgreSQL ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=workouttracker;Username=postgres;Password=postgres

# --- Required: JWT signing (use a long random secret in production) ---
Jwt__SecretKey=your-super-secret-key-change-this-in-production-at-least-32-characters-long

# --- Optional overrides (defaults are in appsettings.json) ---
# Jwt__Issuer=WorkoutTracker.API
# Jwt__Audience=WorkoutTracker.Client
# Jwt__AccessTokenExpirationMinutes=15
# Jwt__RefreshTokenExpirationDays=7
